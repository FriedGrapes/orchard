<Window x:Class="Orchard.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Orchard.Windows"
        Title="Orchard" Width="404" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Foreground="White"
        FontFamily="pack://application:,,,/Assets/fonts/#Pretendard, Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Orchard: 안드로이드 뚜껑 카드(LidCard.kt)와 같은 모양·수치 — 순검정, 연속 곡률 모서리 30, 여백 20/16/22 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Fg2" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Track" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Chip" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Accent" Color="#30D158"/>
        <Style x:Key="RingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Chip}" CornerRadius="15" Padding="14,6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2C2C2E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" Width="30" Height="30" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Ellipse x:Name="e" Fill="{StaticResource Chip}"/>
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Fg2}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Fill" Value="#2C2C2E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="g" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 바깥 여백은 그림자 자리 -->
    <Grid x:Name="Root" Margin="12,12,12,16" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="Slide" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- Canvas 안에 두어 모양이 창 크기 계산에 끼어들지 않게 한다 -->
        <Canvas>
            <Path x:Name="Card" Fill="Black" Stroke="#17FFFFFF" StrokeThickness="1">
                <Path.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/></Path.Effect>
            </Path>
        </Canvas>
        <StackPanel x:Name="Body" Margin="20,16,20,22">
            <!-- 머리말: 가운데 이름 + 오른쪽 닫기 -->
            <Grid Height="30">
                <TextBlock x:Name="NameText" Text="Orchard" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"/>
                <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </Grid>

            <!-- 기기 그림 -->
            <Grid x:Name="ArtRow" Height="140" Margin="0,10,0,0">
                <!-- 알맹이와 케이스를 실제 크기 비율로, 바닥을 맞춰 나란히 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Image x:Name="BudsImg" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" VerticalAlignment="Bottom"/>
                    <Image x:Name="CaseImg" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" VerticalAlignment="Bottom" Margin="18,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 배터리 -->
            <UniformGrid x:Name="Rings" Rows="1" Margin="0,14,0,0">
                <StackPanel x:Name="LeftCell">
                    <Grid Width="52" Height="52"><local:BatteryRing x:Name="LeftRing" Thickness="4.5"/><TextBlock x:Name="LeftPct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="LeftLabel" Text="왼쪽" Style="{StaticResource RingLabel}"/>
                </StackPanel>
                <StackPanel x:Name="RightCell">
                    <Grid Width="52" Height="52"><local:BatteryRing x:Name="RightRing" Thickness="4.5"/><TextBlock x:Name="RightPct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="RightLabel" Text="오른쪽" Style="{StaticResource RingLabel}"/>
                </StackPanel>
                <StackPanel x:Name="CaseCell">
                    <Grid Width="52" Height="52"><local:BatteryRing x:Name="CaseRing" Thickness="4.5"/><TextBlock x:Name="CasePct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="CaseLabel" Text="케이스" Style="{StaticResource RingLabel}"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock x:Name="HintText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Fg2}" Margin="0,10,0,0" Visibility="Collapsed"
                       Text="케이스를 열거나 귀에 꽂으면 바로 나타나요"/>

            <Button x:Name="TakeBtn" Style="{StaticResource ChipButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Visibility="Collapsed" Click="TakeBtn_Click">
                <TextBlock Text="이 PC로 가져오기" FontSize="13" FontWeight="SemiBold"/>
            </Button>

            <!-- 아래쪽(트레이에서 열었을 때만) -->
            <StackPanel x:Name="Footer">
                <Border Height="1" Background="#1AFFFFFF" Margin="-20,16,-20,12"/>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="VersionText" Text="v0.1.0" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" FontSize="12"/>
                    <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Visibility="Collapsed" Click="UpdateBtn_Click">
                        <TextBlock x:Name="UpdateText" Text="업데이트 후 다시 시작" FontSize="12"/>
                    </Button>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
