<Window x:Class="Orchard.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Orchard.Windows"
        Title="Orchard" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Chip}" CornerRadius="10" Padding="10,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                                <Setter TargetName="b" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="20,18,20,16" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform><TranslateTransform x:Name="Slide" Y="0"/></Grid.RenderTransform>
        <StackPanel>
            <!-- 머리말 -->
            <DockPanel>
                <Ellipse x:Name="StateDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource Fg3}" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="NameText" Text="Orchard" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="에어팟을 찾는 중" Foreground="{DynamicResource Fg2}" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- 기기 그림 -->
            <Grid x:Name="ArtRow" Height="150" Margin="0,14,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="CaseCol" Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="BudsImg" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="4"/>
                <Image x:Name="CaseImg" Grid.Column="1" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="10"/>
            </Grid>

            <!-- 배터리 -->
            <UniformGrid x:Name="Rings" Rows="1" Margin="0,4,0,4">
                <StackPanel x:Name="LeftCell">
                    <Grid Width="56" Height="56"><local:BatteryRing x:Name="LeftRing" Thickness="5"/><TextBlock x:Name="LeftPct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="LeftLabel" Text="왼쪽" Style="{StaticResource RingLabel}"/>
                </StackPanel>
                <StackPanel x:Name="RightCell">
                    <Grid Width="56" Height="56"><local:BatteryRing x:Name="RightRing" Thickness="5"/><TextBlock x:Name="RightPct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="RightLabel" Text="오른쪽" Style="{StaticResource RingLabel}"/>
                </StackPanel>
                <StackPanel x:Name="CaseCell">
                    <Grid Width="56" Height="56"><local:BatteryRing x:Name="CaseRing" Thickness="5"/><TextBlock x:Name="CasePct" Style="{StaticResource Pct}"/></Grid>
                    <TextBlock x:Name="CaseLabel" Text="케이스" Style="{StaticResource RingLabel}"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock x:Name="HintText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fg2}" Margin="0,8,0,0" Visibility="Collapsed"
                       Text="케이스를 열거나 귀에 꽂으면 바로 나타나요"/>

            <Button x:Name="TakeBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="Collapsed" Click="TakeBtn_Click">
                <TextBlock Text="이 PC로 가져오기" FontSize="13" FontWeight="SemiBold"/>
            </Button>

            <!-- 아래쪽 -->
            <Border Height="1" Background="{DynamicResource Line}" Margin="-20,14,-20,10"/>
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="VersionText" Text="v0.1.0" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" FontSize="12"/>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Visibility="Collapsed" Click="UpdateBtn_Click">
                    <TextBlock x:Name="UpdateText" Text="업데이트 후 다시 시작" FontSize="12"/>
                </Button>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
