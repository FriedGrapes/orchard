<Window x:Class="Orchard.Windows.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orchard · 폰과 연결" Width="404" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" Foreground="White"
        FontFamily="pack://application:,,,/Assets/fonts/#Pretendard, Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Orchard: 배터리 카드(PopupWindow)와 같은 순검정·연속 곡률 30 카드 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Fg2" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Chip" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Accent" Color="#30D158"/>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Chip}" CornerRadius="13" Padding="12,5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2C2C2E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" Width="30" Height="30" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Ellipse x:Name="e" Fill="{StaticResource Chip}"/>
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Fg2}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Fill" Value="#2C2C2E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="g" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12,12,12,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Canvas>
            <Path x:Name="Card" Fill="Black" Stroke="#17FFFFFF" StrokeThickness="1">
                <Path.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/></Path.Effect>
            </Path>
        </Canvas>
        <StackPanel Margin="20,16,20,22">
            <Grid Height="30" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <TextBlock Text="폰과 연결" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <!-- QR ↔ 연결됨 표시가 같은 자리에서 바뀐다 -->
            <Grid Width="232" Height="232" Margin="0,16,0,0">
                <Grid x:Name="QrTile" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="QrZoom"/></Grid.RenderTransform>
                    <Path x:Name="QrBack" Fill="White"/>
                    <Image x:Name="QrImage" Margin="14" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                </Grid>
                <Grid x:Name="DoneMark" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="DoneZoom" ScaleX="0.6" ScaleY="0.6"/></Grid.RenderTransform>
                    <Ellipse Width="112" Height="112" Fill="{StaticResource Accent}"/>
                    <Path x:Name="Check" Data="M0,22 L18,40 L52,0" Stroke="Black" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="52" Height="40" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,4,0,0" StrokeDashArray="10 10" StrokeDashOffset="10"/>
                </Grid>
            </Grid>

            <TextBlock x:Name="Steps" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Fg2}" Margin="8,16,8,0" LineHeight="19">
                폰의 Orchard → 설정 → PC와 연결에서<LineBreak/>‘QR 찍어 PC 연결’을 누르고 찍어 주세요
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock x:Name="StatusText" Text="폰을 기다리는 중…" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- 연결된 폰 -->
            <StackPanel x:Name="PeersBox" Visibility="Collapsed">
                <Border Height="1" Background="#1AFFFFFF" Margin="-20,18,-20,12"/>
                <TextBlock Text="연결된 폰" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl x:Name="PeerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Tag="{Binding Id}" Click="Remove_Click" VerticalAlignment="Center">
                                    <TextBlock Text="끊기" FontSize="12"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Seen}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
